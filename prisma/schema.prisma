// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  FAT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  PERFORMANCE
  RECOMPOSITION
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

enum TrainingStatus {
  REST
  PLANNED
  COMPLETED
  MISSED
}

enum ProgramLevel {
  YEAR
  MONTH
  WEEK
}

enum PhaseType {
  MUSCLE_GAIN
  STRENGTH
  FAT_LOSS
  MAINTENANCE
  DELOAD
}

model UserProfile {
  id                  String           @id @default(cuid())
  displayName         String
  birthYear           Int?
  birthDate           DateTime?
  injuryHistory       String?
  sex                 Sex              @default(UNSPECIFIED)
  heightCm            Float
  activityLevel       ActivityLevel    @default(MODERATE)
  trainingExperience  String?
  defaultWakeTime     String?
  defaultSleepTime    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  bodyMetrics         BodyMetric[]
  goals               Goal[]
  dietPreference      DietPreference?
  dailyLogs           DailyLog[]
  foodEntries         FoodEntry[]
  trainingSessions    TrainingSession[]
  nutritionTargets    NutritionTarget[]
  programs            Program[]
  plannedSessions     PlannedSession[]
  adjustmentLogs      AdjustmentLog[]
}

model BodyMetric {
  id             String      @id @default(cuid())
  userId         String
  date           DateTime
  weightKg         Float
  bodyFatPercent   Float?
  leanBodyMassKg   Float?
  waistCm          Float?
  chestCm          Float?
  hipCm            Float?
  armCm            Float?
  thighCm          Float?
  restingHeartRate Int?
  source           String?
  note             String?
  user           UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Goal {
  id                    String      @id @default(cuid())
  userId                String
  type                  GoalType
  title                 String
  targetWeightKg        Float?
  targetBodyFatPercent  Float?
  weeklyWeightDeltaKg   Float?
  startDate             DateTime
  endDate               DateTime?
  priority              Int         @default(1)
  isActive              Boolean     @default(true)
  user                  UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model DietPreference {
  id                    String      @id @default(cuid())
  userId                String      @unique
  dietStyle             String?
  allergies             String[]    @default([])
  avoidedFoods          String[]    @default([])
  preferredFoods        String[]    @default([])
  dislikedFoods         String[]    @default([])
  budgetLevel           String?
  maxCookingMinutes     Int?
  mealsPerDay           Int         @default(3)
  notes                 String?
  user                  UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id              String         @id @default(cuid())
  userId          String
  date            DateTime
  sleepHours      Float?
  stressLevel     Int?
  scheduleNote    String?
  trainingStatus  TrainingStatus @default(REST)
  user            UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodEntries     FoodEntry[]

  @@unique([userId, date])
  @@index([userId, date])
}

model FoodEntry {
  id          String      @id @default(cuid())
  userId      String
  dailyLogId  String?
  eatenAt     DateTime
  mealType    MealType
  foodName    String
  quantity    Float
  unit        String
  calories    Float
  proteinG    Float
  carbsG      Float
  fatG        Float
  source      String?
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLog    DailyLog?   @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)

  @@index([userId, eatenAt])
}

model Exercise {
  id               String @id @default(cuid())
  name             String @unique
  primaryMuscle    String
  movementPattern  String
  equipment        String
}

model TrainingSession {
  id          String        @id @default(cuid())
  userId      String
  date        DateTime
  title       String
  type        String
  durationMin Int?
  notes       String?
  user        UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets        ExerciseSet[]

  @@index([userId, date])
}

model ExerciseSet {
  id                String          @id @default(cuid())
  trainingSessionId String
  exerciseName      String
  setNumber         Int
  reps              Int
  weightKg          Float?
  rpe               Float?
  note              String?
  plannedExerciseId String?
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  plannedExercise   PlannedExercise? @relation(fields: [plannedExerciseId], references: [id], onDelete: SetNull)

  @@index([trainingSessionId, exerciseName])
}

model NutritionTarget {
  id            String      @id @default(cuid())
  userId        String
  effectiveDate DateTime
  calories      Float
  proteinG      Float
  carbsG        Float
  fatG          Float
  formula       String
  createdAt     DateTime    @default(now())
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveDate])
}

model Program {
  id        String         @id @default(cuid())
  userId    String
  parentId  String?
  level     ProgramLevel
  phaseType PhaseType
  title     String
  startDate DateTime
  endDate   DateTime
  user      UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Program?       @relation("ProgramTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Program[]      @relation("ProgramTree")
  sessions  PlannedSession[]

  @@index([userId, startDate])
}

model PlannedSession {
  id         String            @id @default(cuid())
  userId     String
  programId  String
  date       DateTime
  theme      String
  user       UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  program    Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises  PlannedExercise[]

  @@index([userId, date])
}

model PlannedExercise {
  id               String         @id @default(cuid())
  plannedSessionId String
  exerciseName     String
  sortOrder        Int
  sets             Int
  repsMin          Int
  repsMax          Int
  intensityType    String
  intensityValue   Float
  restSeconds      Int
  targetWeightKg   Float?
  session          PlannedSession @relation(fields: [plannedSessionId], references: [id], onDelete: Cascade)
  loggedSets       ExerciseSet[]

  @@index([plannedSessionId, sortOrder])
}

model AdjustmentLog {
  id          String      @id @default(cuid())
  userId      String
  date        DateTime
  reason      String
  field       String
  subject     String
  beforeValue String
  afterValue  String
  createdAt   DateTime    @default(now())
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
